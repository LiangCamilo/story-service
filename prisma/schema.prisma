generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StoryStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  PAUSED
}

model Story{
  id String @id @db.Uuid
  title String @unique
  coverUrl String @default("")
  description String
  totalRating Decimal @default(0) @db.Decimal(4, 2)
  ratingSum    Decimal @default(0) @db.Decimal(10, 2)
  ratingCount  Int     @default(0)
  totalChapters Int @default(0) 
  hidden Boolean @default(true)
  status StoryStatus @default(IN_PROGRESS)
  totalViews Int @default(0)
  userId String @db.Uuid
  totalFavorite Int @default(0)
  totalComments Int @default(0)

  genreId String @db.Uuid
  secondaryGenreId  String? @db.Uuid
  chapters Chapter[]

  genre Genre @relation("MainGenre", fields: [genreId], references: [id] )
  secondaryGenre Genre? @relation("SecondaryGenre", fields: [secondaryGenreId], references: [id])

  comments Comment[]
  tags Tag[]
  ratings Rating[]
  views View[]
  favoriteStories FavoriteStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime?
  lastActivityAt DateTime?
}

model FavoriteStory {
  id String @id @db.Uuid
  storyId String @db.Uuid
  userId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  @@unique([storyId, userId])
}

model Genre {
  id String @id @db.Uuid
  name String @unique

  storiesAsMain Story[] @relation("MainGenre")
  storiesAsSub Story[] @relation("SecondaryGenre")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag { 
  id String @id @db.Uuid
  name String @unique

  stories Story[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model Chapter {
  id String @id @db.Uuid
  title String
  order Int
  content String @db.Text
  hidden Boolean @default(true)
  totalComments Int @default(0)

  storyId String @db.Uuid
  @@unique([storyId, order])

  comments Comment[]

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime?
  lastActivityAt DateTime?
}

model Comment {
  id String @id @db.Uuid
  username String
  userId String
  content String
  likes Int @default(0)

  storyId String? @db.Uuid
  chapterId String? @db.Uuid

  story Story? @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  commentLikes CommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime? 
}

model Rating {
  id String @id @db.Uuid
  storyId String @db.Uuid
  userId String @db.Uuid
  score Decimal @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model View {
  id String @id @db.Uuid
  storyId String @db.Uuid
  userId String @db.Uuid

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, userId])
}

model CommentLike {
  id String @id @db.Uuid
  commentId String @db.Uuid
  userId String @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}